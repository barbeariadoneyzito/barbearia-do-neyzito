{
  "name": "AnalyticsEvent",
  "type": "object",
  "properties": {
    "tipo_evento": {
      "type": "string",
      "enum": [
        "visita",
        "clique",
        "chat_aberto",
        "chat_interacao",
        "secao_vista",
        "scroll_profundidade"
      ]
    },
    "destino": {
      "type": "string"
    },
    "origem_botao": {
      "type": "string"
    },
    "pagina": {
      "type": "string"
    },
    "referrer": {
      "type": "string"
    },
    "utm_source": {
      "type": "string"
    },
    "utm_medium": {
      "type": "string"
    },
    "utm_campaign": {
      "type": "string"
    },
    "dispositivo": {
      "type": "string",
      "enum": [
        "mobile",
        "desktop",
        "tablet",
        "outro"
      ]
    },
    "sessao_id": {
      "type": "string"
    },
    "canal": {
      "type": "string",
      "description": "Canal classificado a partir de referrer/UTM/gclid (ex.: Google Ads, Google Business Profile, IA \u2014 ChatGPT, Acesso direto)."
    },
    "gclid": {
      "type": "string",
      "description": "Identificador de clique do Google Ads (auto-tagging), quando presente."
    }
  },
  "required": [
    "tipo_evento",
    "sessao_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}